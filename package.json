{
  "name": "p2p-latex",
  "version": "1.0.0",
  "description": "Local-first LaTeX editor with peer-to-peer collaboration",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test tests/*.test.ts",
    "stress": "tsx tests/stress/run.ts",
    "dist": "electron-vite build && electron-builder",
    "dist:dir": "electron-vite build && electron-builder --dir",
    "test:p2p": "node tests/p2p-integration.mjs"
  },
  "keywords": ["latex", "editor", "collaboration", "p2p", "local-first", "overleaf-alternative"],
  "author": "William L <contact@thabotech.com>",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "b4a": "^1.8.1",
    "chokidar": "^5.0.0",
    "hyperswarm": "^4.17.0",
    "z32": "^1.1.0"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.3",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.6",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "codemirror": "^6.0.2",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "pdfjs-dist": "^6.1.200",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "vite": "^7.3.6",
    "y-codemirror.next": "^0.3.5",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.31"
  }
}